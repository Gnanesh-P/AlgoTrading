# ── Maven build output ────────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE — IntelliJ IDEA ───────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# ── IDE — Eclipse ─────────────────────────────────────────────────────────────
.classpath
.project
.settings/
bin/

# ── IDE — VS Code ─────────────────────────────────────────────────────────────
.vscode/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Environment / secrets — NEVER commit these ────────────────────────────────
.env
*.env
.env.local
.env.production

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
spring.log

# ── Spring Boot devtools restart trigger ──────────────────────────────────────
.spring-boot-devtools.properties

# ── Compiled class files ──────────────────────────────────────────────────────
*.class

# ── Package files ─────────────────────────────────────────────────────────────
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
